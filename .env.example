# ReuseGuard reads credentials from the process environment.
# This file is a reference template only: ReuseGuard does not load .env files.
#
# A token raises the GitHub REST limit from 60 to 5,000 requests/hour.
# Without one, ReuseGuard also tries `gh auth token` when the gh CLI is available.
GITHUB_TOKEN=
# GH_TOKEN=            # accepted as an alternative
